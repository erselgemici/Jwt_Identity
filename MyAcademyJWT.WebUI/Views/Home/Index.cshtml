@using MyAcademyJWT.WebUI.Models.Song
@model List<ResultSongDto>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<style>
    body {
        background-image: linear-gradient(rgba(15, 15, 20, 0.5), rgba(15, 15, 20, 0.95)), url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=2070&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }
    .page-hero .bg-media {
        display: none !important;
    }
</style>

<div class="sr">
    <div class="page-hero page-container">
        <div class="p-5 pos-rlt text-center">
            <h1 class="display-3 font-weight-bold text-white mb-5 mx-5">Sanatçılar ve ses platformları için müzik şablonu.</h1>
            <a href="/Home/Discover" class="btn btn-md gd-primary text-white no-ajax m-2">Yeni Müzikler Keşfet</a>
            <a href="/Package/Index" class="btn btn-md btn-outline-light no-ajax m-2">Satın Al</a>
        </div>
    </div>
    
    <div class="page-container p-5 pos-rlt">
        <div class="py-5 text-center">
            <h2 class="display-4 font-weight-bold text-white mb-5">Bepop'taki Sanatçılar</h2>
            <p>En popüler sanatçıları bul ve müziklerini Bepop'ta dinle. Onları dinlerken kendi çalma listeni oluştur.</p>
            <div class="py-4">
                <a href="/Artist/Index" class="btn btn-md btn-outline-primary no-ajax m-2">Sanatçıları Keşfet</a>
                <a href="/Package/Index" class="btn btn-md btn-outline-primary no-ajax m-2">Satın Al</a>
            </div>
        </div>
    </div>

    @if (ViewBag.RecentlyPlayed != null && ((List<ResultSongDto>)ViewBag.RecentlyPlayed).Any())
    {
        <div class="page-container px-5 pb-5">
            <div class="heading pt-2 pb-3 d-flex">
                <div>
                    
                    <h5 class="text-highlight sr-item text-white">Son Dinlediklerin</h5>
                </div>
            </div>

            <div class="row list-row list-index mb-4">
                @foreach (var historySong in ViewBag.RecentlyPlayed)
                {
                    <div class="col-12 col-md-6 col-lg-4 mb-2">
                        <div class="list-item r bg-dark" style="border-radius: 10px;">
                            <div class="media">
                                <a href="javascript:void(0);" onclick="playGlobalSong(@historySong.Id)" class="media-content no-ajax" style="background-image:url('@historySong.CoverImageUrl')"></a>
                                <div class="media-action">
                                    <a href="javascript:void(0);" onclick="playGlobalSong(@historySong.Id)" class="btn btn-raised btn-icon btn-rounded bg--white btn-play no-ajax" style="display: flex; align-items: center; justify-content: center;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="#a272ff" stroke="#a272ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                    </a>
                                </div>
                            </div>
                            <div class="list-content">
                                <div class="list-body">
                                    <a href="javascript:void(0);" onclick="playGlobalSong(@historySong.Id)" class="list-title title h-1x text-white no-ajax">@historySong.Title</a>
                                    <span class="list-subtitle d-block text-muted h-1x subtitle">@historySong.ArtistName</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <hr class="border-secondary mt-5 mb-4" />
        </div>
    }

    @if (ViewBag.Recommendations != null && ((List<ResultSongDto>)ViewBag.Recommendations).Any())
    {
        <div class="page-container px-5 pb-5">
            <div class="heading pt-2 pb-3 d-flex align-items-center">
                <div>
                    
                    <h5 class="text-highlight sr-item text-white">Sizin İçin Önerilenler ✨</h5>
                </div>
            </div>

            <div class="row list-row list-index mb-4">
                @foreach (var aiSong in ViewBag.Recommendations)
                {
                    <div class="col-12 col-md-6 col-lg-4 mb-2">
                        <div class="list-item r bg-dark border-primary" style="border-radius: 10px; border-width: 1px; border-style: solid;">
                            <div class="media">
                                <a href="javascript:void(0);" onclick="playGlobalSong(@aiSong.Id)" class="media-content no-ajax" style="background-image:url('@aiSong.CoverImageUrl')"></a>
                                <div class="media-action">
                                    <a href="javascript:void(0);" onclick="playGlobalSong(@aiSong.Id)" class="btn btn-raised btn-icon btn-rounded bg-primary text-white btn-play no-ajax" style="display: flex; align-items: center; justify-content: center;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                    </a>
                                </div>
                            </div>
                            <div class="list-content">
                                <div class="list-body">
                                    <a href="javascript:void(0);" onclick="playGlobalSong(@aiSong.Id)" class="list-title title h-1x text-white no-ajax">@aiSong.Title</a>
                                    <span class="list-subtitle d-block text-muted h-1x subtitle">@aiSong.ArtistName</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <hr class="border-secondary mt-5 mb-4" />
        </div>
    }

